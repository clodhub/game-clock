{
  "id": "com.clodhub.game-clock",
  "name": "Game clock",
  "kind": "component",
  "status": "example",
  "package": "pkg:clod/com.clodhub/game-clock",
  "version": "0.11.0",
  "ports": [
    {
      "id": "game-clock",
      "name": "Game clock",
      "direction": "output",
      "kind": "interface",
      "type": "com.clodhub/game-clock",
      "version": "1.0.0"
    }
  ],
  "settings": [
    {
      "id": "decisionSeconds",
      "name": "Decisionseconds",
      "type": "number",
      "required": false,
      "secret": false,
      "default": 30
    },
    {
      "id": "onTimeout",
      "name": "Ontimeout",
      "type": "string",
      "required": false,
      "secret": false,
      "default": "check-or-fold"
    }
  ]
}
